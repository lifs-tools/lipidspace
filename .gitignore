*.o
*.swp
.vscode
objects/

# qmake / Qt Creator build output. Anchored to the repository root so that
# nothing inside ClassMatrixComputation/ or other subprojects is caught.
/Makefile
/Makefile.Debug
/Makefile.Release
/build/
/Build/
/debug/
/release/
.qmake.stash
.qtcreator/
*.pro.user
*.pro.user.*

# Generated by qmake from RC_ICONS / VERSION
/LipidSpace_resource.rc

# The application binaries, which qmake writes into the source root on
# Linux and macOS.
#
# git is configured case-insensitively on Windows (core.ignoreCase=true), so
# "/LipidSpace" also matches the lipidspace/ header directory and would make
# `git add lipidspace/some-new-header.h` silently do nothing. Re-include that
# directory explicitly. Keep the negation after the rule it negates.
/LipidSpace
/LipidSpaceRest
!/lipidspace/

# The generated macOS application bundles. qmake assembles these from
# LipidSpace.app/Contents/... at build time, so nothing inside them belongs in
# the repository.
/LipidSpace.app/
/LipidSpaceRest.app/

# macOS signing material. A leaked Developer ID private key means burning a
# certificate slot, and the account holder is the only one who can issue
# another.
*.dmg
*.p12
*.p8
